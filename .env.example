# Authentication identity
ADMIN_ID=admin-001
ADMIN_NAME=Abstract Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Session configuration
# Generate a unique value with at least 32 characters for each environment.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
AUTH_SESSION_COOKIE_NAME=abstract_admin_session
AUTH_SESSION_DURATION_SECONDS=28800
AUTH_COOKIE_SECURE=false
